# 本地 build 时填写 Ubuntu Host 当前用户的 UID/GID。
# 教程使用 `id -u` / `id -g` 自动生成 .env，不建议手工猜值。
LOCAL_UID=1000
LOCAL_GID=1000

# 默认使用本地 Image；发布到 GHCR 后可替换为实际远端地址。
WIFI_DIRECT_IMAGE=wifi-direct-lab:2.12

# 教程中的逻辑接口变量。默认 mac80211_hwsim 环境通常为 wlan0 / wlan1。
# 这两个变量不会重命名网卡；如果 `iw dev` 显示其他名称，在本地 .env 中修改即可。
P2P_A=wlan0
P2P_B=wlan1
